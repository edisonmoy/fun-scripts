# Copy to .env and fill in. NEVER commit the filled-in version.
# Both values come from DevTools -> Network on a logged-in resy.com tab:
# click any api.resy.com request and read its request headers.
RESY_API_KEY=            # from: Authorization: ResyAPI api_key="..."
RESY_AUTH_TOKEN=         # from: X-Resy-Auth-Token (expires ~45 days)

# Resolve once with: python cli.py find-venue "Pizza 4P's"
RESY_VENUE_ID=

# Booking is off until you explicitly turn it on.
RESY_LIVE_BOOKING=0
# Max cancellation fee (dollars) the bot may commit you to. 0 = none.
RESY_MAX_CANCELLATION_FEE=0

# Gmail address + 16-char app password (not your Google password).
ALERT_EMAIL_FROM=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TO=

# Vercel only: random string, must match the CRON_SECRET env var in Vercel.
CRON_SECRET=

# Testing affordance: which weekdays to scan (Mon=0 ... Sun=6).
# Unset means Saturdays only. "0,1,2,3,4,5,6" scans every day, which is what
# you want when smoke-testing against a restaurant with easy availability.
RESY_WEEKDAYS=
