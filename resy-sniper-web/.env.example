# Shared password to log into the dashboard.
ADMIN_PASSWORD=

# Signs the session cookie - any long random string, unrelated to ADMIN_PASSWORD.
AUTH_SECRET=

# Fine-grained GitHub PAT, scoped to just the edisonmoy/fun-scripts repo,
# with Contents: Read and write permission. Used to commit changes to
# resy-sniper/targets.json.
GITHUB_TOKEN=

# Used by "Check venue & request" to preview how Claude will parse a
# target's request text.
ANTHROPIC_API_KEY=

# Same values as the resy-sniper bot's Fly secrets - for venue search,
# live reservation status, and cancellation.
RESY_AUTH_TOKEN=
RESY_API_KEY=
